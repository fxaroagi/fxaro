# FXARO Environment Variables

# OpenRouter API (AI Trading Signals)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Stripe Payment Processing
STRIPE_PUBLIC_KEY=pk_test_your-key-here
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# SendGrid Email Service
SENDGRID_API_KEY=SG.your-api-key-here
SENDGRID_FROM_EMAIL=noreply@fxaro.com

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Apple OAuth
APPLE_CLIENT_ID=com.fxaro.app
APPLE_CLIENT_SECRET=your-client-secret
APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id

# NewsAPI Integration
NEWSAPI_KEY=your-newsapi-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fxaro

# Monitoring & Analytics
SENTRY_DSN=https://your-sentry-url

# Node Environment
NODE_ENV=development
